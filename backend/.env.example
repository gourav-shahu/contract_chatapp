# Databricks Configuration
DATABRICKS_HOST=https://your-instance.azuredatabricks.net
DATABRICKS_WORKSPACE_RESOURCE_ID=/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.Databricks/workspaces/your-workspace

# Microsoft Azure Configuration
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=your-tenant-id

# Databricks Serving Endpoint
SERVING_ENDPOINT_NAME=databricks-meta-llama-3-70b-instruct

# Unity Catalog Path
VOLUME_PATH=/Volumes/your-catalog/your-schema/your-path/

# Database Configuration
DATABASE_URL=sqlite:///./chat_app.db

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
